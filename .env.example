# Copy to .env and fill in real values. .env is git-ignored. Never commit secrets.
POSTGRES_USER=reconcileai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reconcileai
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Deterministic engine ---
WINDOW_DAYS=3            # date window for rules R2/R3
AI_WINDOW_DAYS=30        # wider window for AI-verified references (R4)
AUTO_MATCH_RULES=R1      # R4 (AI) is never auto-matched, whatever this says

# --- Inference ---
# mock = regex stand-in for development. It is NOT a model and NOT AMD inference; the UI labels it MOCK.
# vllm = your own OpenAI-compatible vLLM endpoint (see docs/amd-vllm-deploy.md). No endpoint is assumed.
INFERENCE_PROVIDER=mock
INFERENCE_BASE_URL=          # e.g. http://<your-droplet-ip>:8000/v1  (you provide it)
INFERENCE_API_KEY=           # must match the --api-key you start vLLM with
INFERENCE_MODEL=             # exact model id served by vLLM
INFERENCE_TIMEOUT_S=30
INFERENCE_MAX_RETRIES=2
INFERENCE_HARDWARE_LABEL=    # free text you declare, e.g. "AMD Developer Cloud / ROCm". Not verified by the app.

# --- Evolus ---
# disabled (default) | mock (SIMULATED, no network) | live (needs the values below from your Evolus workspace)
EVOLUS_MODE=disabled
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=
EVOLUS_WORKFLOW_ID=
EVOLUS_EXTRACTOR_AGENT_ID=
EVOLUS_EXTRACTOR_ID=
# Bearer token the Evolus workflow uses to call /agent/*. Empty = that API is off. Generate with: openssl rand -hex 32
AGENT_API_TOKEN=
